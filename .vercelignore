# The Expo scanner is built and shipped by Storeship, never Vercel. Exclude the
# entire workspace so generated CocoaPods symlinks and native binaries cannot be
# discovered, archived, or treated as another deployable application.
apps/mobile
apps/mobile/**

# Local build artifacts and dependencies are restored by Vercel from manifests.
node_modules
node_modules/**
**/node_modules
**/node_modules/**
**/.next
**/.next/**
**/.expo
**/.expo/**
**/dist
**/dist/**
.git
.git/**
