{
  "expo": {
    "name": "QR Code by teag.me",
    "slug": "teagme-scanner",
    "scheme": "teagme-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.teag.scanner",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "me.teag.scanner",
      "adaptiveIcon": {
        "backgroundColor": "#2b5acb",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "QR Code by teag.me uses the camera to read QR codes you point it at.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "QR Code by teag.me reads a QR code from a photo you choose. The image is decoded on your device and never uploaded."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-iap",
      "expo-sharing",
      "expo-media-library"
    ]
  }
}
