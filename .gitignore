# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + every workspace package)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
/out/

# production
/build

# expo / react native
.expo/
dist/
*.orig.*
web-build/

# native
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

secrets.json
firebase_secrets.json
.claude
